# Privy dashboard > your app > Settings. Add your site domain under Allowed origins.
VITE_PRIVY_APP_ID=
# Address of the deployed FabrikaVault on Monad testnet
VITE_VAULT_ADDRESS=
# Telegram bot username without @ (used on the claim page, stage 3)
VITE_BOT_USERNAME=

# ---- Server only (stage 3). Set these in Vercel > Settings > Environment Variables. Never prefix with VITE_.
# Same value as VITE_PRIVY_APP_ID (falls back to it if unset)
PRIVY_APP_ID=
# Privy dashboard > Settings > Basic > App secret. Needed to verify X (Twitter) accounts on the server. Never prefix with VITE_.
PRIVY_APP_SECRET=
# Private key of the address you passed to the FabrikaVault constructor. Make one with: node scripts/gen-key.mjs
AUTHORIZER_PRIVATE_KEY=
# Optional separate wallet that pays gas for claims. Needs MON from the faucet. Defaults to the authorizer.
RELAYER_PRIVATE_KEY=
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=
# Free Upstash Redis database (Vercel Marketplace > Upstash, or upstash.com). Use the REST URL and token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
